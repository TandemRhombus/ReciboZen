    <!-- States catalog -->
    <string name="states_catalog_intro">Guía de los avisos que puede mostrarte la app y qué conviene hacer con cada uno. Si algo sigue sin cuadrar, repórtalo desde Ayuda.</string>
    <string name="states_catalog_dubious_what_to_do">Qué hacer: vuelve a revisar el número. Si está bien, guárdalo; la app lo marcará para no arrastrar el error a la proyección.</string>

    <string name="states_catalog_eyebrow_loading">CALCULANDO</string>
    <string name="states_catalog_loading_caption">Estamos recalculando con tus datos. Puedes seguir usando el resto de la app.</string>

