local.properties

# ReciboZen backend runtime material. The entitlement private key must only
# exist on the server; never add it to Git or to the Android application.
/backend/secrets/
/backend/.env

# Upload key for Google Play. Losing this file means the app can never be
# updated again; committing it means anyone can publish in your name. Keep a
# backup somewhere outside the repository.
/keystore.properties
# Backups and editor copies of the same file carry the same passwords.
/keystore.properties.*
*.jks
*.keystore

# Local scratch: transfer folders, staged deletions and throwaway archives.
# Never part of a build; keep them out of the history.
/tmp/

# Local clone of the public legal site (TandemRhombus/recibozen-legal).
# The published policy lives there; a copy here would only drift.
/site/privacidad/recibozen-legal/

# Device screenshots: they carry the owner's real bills, name and address.
/capturas/

# Claude Design export working copy: large, regenerable from the .zip.
/design_src/
# Promo art that still shows the owner name and service address.
/play_assets/capturas/_BLOQUEADAS_datos_personales/
