# ReciboZen backend runtime material. The entitlement private key must only
# exist on the server; never add it to Git or to the Android application.
/backend/secrets/
/backend/.env

# Upload key for Google Play. Losing this file means the app can never be
# updated again; committing it means anyone can publish in your name. Keep a
# backup somewhere outside the repository.
/keystore.properties
*.jks
*.keystore

# Local scratch: transfer folders, staged deletions and throwaway archives.
# Never part of a build; keep them out of the history.
/tmp/
